# === GPU-accelerated build ===
# Uses CUDA for ffsubsync GPU acceleration (CuPy backend).
# Build: docker build -f Dockerfile.gpu -t davidsteg/subsyncarr:gpu .
# Run:   docker run --gpus all -v /media:/media -v ./data:/app/data davidsteg/subsyncarr:gpu

FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Ubuntu 22.04 base so the binary links against the runtime's glibc.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS server
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs CHANGELOG.md ./
COPY src ./src
COPY --from=web /web/dist ./web/dist
RUN cargo build --release

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV PUID=1000 \
    PGID=1000 \
    CRON_SCHEDULE="0 0 * * *" \
    DB_PATH=/app/data/subsyncarr-plus.db \
    PIPX_HOME=/opt/pipx \
    PIPX_BIN_DIR=/opt/pipx/bin \
    PATH="/opt/pipx/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv pipx build-essential python3-dev ffmpeg curl ca-certificates \
    && dpkgArch="$(dpkg --print-architecture)" \
    && curl -fsSL "https://github.com/tianon/gosu/releases/download/1.17/gosu-$dpkgArch" -o /usr/local/bin/gosu \
    && chmod +x /usr/local/bin/gosu \
    && pipx install ffsubsync \
    && pipx inject ffsubsync 'setuptools<82' cupy-cuda12x \
    && pipx install autosubsync \
    && pipx inject autosubsync 'setuptools<82' \
    && find /opt/pipx -type d -name "__pycache__" -prune -exec rm -rf {} + \
    && apt-get purge -y build-essential python3-dev && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 subsyncarr \
    && useradd -m -u 1000 -g 1000 -s /bin/bash subsyncarr \
    && mkdir -p /app/data && chown subsyncarr:subsyncarr /app/data

COPY --chmod=755 bin/alass /usr/local/bin/alass
COPY --from=server /src/target/release/subsyncarr /usr/local/bin/subsyncarr
COPY --chmod=755 entrypoint.sh /entrypoint.sh

WORKDIR /app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD curl -fsS http://127.0.0.1:3000/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["subsyncarr"]
